{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workos.local/schemas/workos-app-manifest-v1.schema.json",
  "title": "WorkOS App Manifest v1",
  "type": "object",
  "required": [
    "apiVersion",
    "id",
    "name",
    "version",
    "scope",
    "runtime",
    "surfaces",
    "permissions",
    "resources",
    "health",
    "maintainer"
  ],
  "properties": {
    "apiVersion": { "const": "workos.app/v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "scope": { "enum": ["system", "user", "project"] },
    "runtime": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "trusted",
            "container",
            "background-service",
            "remote-native",
            "remote-browser",
            "web-bundle"
          ]
        },
        "image": { "type": "string" },
        "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "artifactId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "artifactDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "renderer"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "renderer": { "enum": ["web-bundle", "web-service", "declarative", "remote-native"] },
          "route": { "type": "string" },
          "adaptive": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" },
      "uniqueItems": true
    },
    "resources": { "type": "object", "additionalProperties": true },
    "health": { "type": "object", "additionalProperties": true },
    "maintainer": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "type": "object",
            "properties": { "type": { "const": "container" } },
            "required": ["type"]
          }
        },
        "required": ["runtime"]
      },
      "then": {
        "properties": {
          "runtime": {
            "required": ["image", "command", "port"],
            "properties": {
              "image": { "type": "string", "pattern": "^[^@]+@sha256:[0-9a-f]{64}$" },
              "command": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
              }
            }
          },
          "surfaces": { "maxItems": 1 }
        }
      }
    }
  ],
  "additionalProperties": false
}
