.DS_Store
.env
.env.*
!.env.example
.idea/
.vscode/

# Go
/bin/
/coverage/
*.out

# TypeScript
node_modules/
dist/
.vite/
playwright-report/
test-results/

# Generated runtime data
/.workos/
/data/
/tmp/

# Local tool caches
/.cache/
/.pnpm-store/
/.tools/

# Accidental local build output (go build ./tests/restart writes ./restart,
# go build ./cmd/workos-core writes ./workos-core); the exact root paths only —
# tests/restart/ source stays tracked.
/restart
/workos-core
/devauth
/deepseekapi

# A host-absolute capture path passed into a container can otherwise mirror
# the host's /home/... tree under the repository working directory.
/home/

# Nested pnpm stores created by containerized installs
.pnpm-store/

# Stray Go build outputs (go build ./cmd/x writes into the working directory)
/runtime-host
/workos-core
/harness-host
/indexer
/workos-gateway
/reliability-host
/workosctl
/workos-dev-fixture
