WORKOS_HTTP_ADDRESS=127.0.0.1:8085
WORKOS_INDEX_ADMIN_SOCKET=/run/workos-indexer/admin.sock
# Replace with an independently generated stable secret of at least 32 bytes.
# Rotation intentionally invalidates open search page tokens.
WORKOS_INDEX_PAGE_TOKEN_KEY=CHANGE_ME_TO_A_RANDOM_32_BYTE_MINIMUM_SECRET
