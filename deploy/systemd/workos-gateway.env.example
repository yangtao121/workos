# Install as /etc/workos/workos-gateway.env with mode 0600.
WORKOS_HTTP_ADDRESS=127.0.0.1:8080
WORKOS_STATIC_DIR=/usr/share/workos/desktop

# Development bypass (loopback only, fixed configured identity, no cookies).
# Leave WORKOS_DEV_AUTH_BYPASS=true ONLY for single-host development.
# WORKOS_DEV_AUTH_BYPASS=true

# Production device authentication (ADR-0007): the gateway terminates its own
# TLS 1.3, publishes one canonical https origin, and serves pairing over a
# Gateway-owned admin Unix socket. WORKOS_DEVICE_ID is not used in this mode;
# device identities are minted by the gateway.
#
#   WORKOS_DEV_AUTH_BYPASS=false
#   WORKOS_HTTP_ADDRESS=:443
#   WORKOS_HTTP_TLS_CERT_FILE=/etc/workos/tls/leaf.crt
#   WORKOS_HTTP_TLS_KEY_FILE=/etc/workos/tls/leaf.key
#   WORKOS_AUTH_PUBLIC_ORIGIN=https://workos.example
#   WORKOS_AUTH_ADMIN_SOCKET=/run/workos/gateway-admin.sock
#
# Optional TTL bounds (defaults): pairing ticket 5m (1m–15m), proof challenge
# 2m (30s–5m), device session 24h (5m–30d).
#   WORKOS_AUTH_PAIRING_TICKET_TTL=5m
#   WORKOS_AUTH_PROOF_CHALLENGE_TTL=2m
#   WORKOS_AUTH_SESSION_TTL=24h
#
# Operators pair a device with:
#   sudo -u workos workosctl device pair
# which prints the one-time pairing URL (secret in the fragment) and a
# terminal QR. Rotating again invalidates every previously displayed QR.
