WORKOS_HTTP_ADDRESS=127.0.0.1:8082
WORKOS_CORE_URL=http://127.0.0.1:8081

# DeepSeek stays disabled unless explicitly enabled. Long-lived provider API
# keys NEVER live in this environment (ADR-0009): store them in the Core
# Credential Vault via `workosctl credential put` over the Core admin Unix
# socket; harness-host receives them only as short-lived task-bound leases.
WORKOS_DEEPSEEK_ENABLED=false
WORKOS_DEEPSEEK_BASE_URL=https://api.deepseek.com
WORKOS_DEEPSEEK_MODEL=deepseek-v4-flash
WORKOS_DEEPSEEK_TIMEOUT=2m
WORKOS_DEEPSEEK_RUNTIME_PATH=/usr/local/libexec/workos/dsh-jsonrpc-agent
WORKOS_DEEPSEEK_CORDIS_CONFIG=/etc/workos/deepseek.cordis.yml

# Private mutually authenticated execution channel to workos-core (ADR-0009).
# Provision the CA, this process's leaf certificate, and its mode-0600 key
# through the checked-in unit credential drop-in; the CA private key, Core
# leaf key, and vault master key never reach this host process.
WORKOS_CORE_EXECUTION_URL=https://127.0.0.1:8086
