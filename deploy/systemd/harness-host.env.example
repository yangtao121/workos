WORKOS_HTTP_ADDRESS=127.0.0.1:8082
WORKOS_CORE_URL=http://127.0.0.1:8081

# DeepSeek stays disabled unless explicitly enabled. Install the real key only
# in this mode-0600 environment file; never put it in workos.yaml or source.
WORKOS_DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
WORKOS_DEEPSEEK_BASE_URL=https://api.deepseek.com
WORKOS_DEEPSEEK_MODEL=deepseek-v4-flash
WORKOS_DEEPSEEK_TIMEOUT=2m
WORKOS_DEEPSEEK_RUNTIME_PATH=/usr/local/libexec/workos/dsh-jsonrpc-agent
WORKOS_DEEPSEEK_CORDIS_CONFIG=/etc/workos/deepseek.cordis.yml
