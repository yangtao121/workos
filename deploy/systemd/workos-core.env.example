WORKOS_HTTP_ADDRESS=127.0.0.1:8081
WORKOS_HARNESS_URL=http://127.0.0.1:8082
WORKOS_AGENT_CATALOG_TIMEOUT=2s

# Private harness execution listener (ADR-0009): the only surface for
# TaskExecution + CredentialLease RPCs. Mutual TLS 1.3 with exact URI SAN
# identities; provision via systemd credentials.
WORKOS_CORE_EXECUTION_ADDRESS=127.0.0.1:8086
WORKOS_CORE_EXECUTION_CA_FILE=/etc/workos/execution/ca.crt
WORKOS_CORE_EXECUTION_CERT_FILE=/etc/workos/execution/core.crt
WORKOS_CORE_EXECUTION_KEY_FILE=/etc/workos/execution/core.key

# Credential Vault (ADR-0009). Master key: exactly 32 raw bytes, mode 0600,
# owned by the core process user, never in env values, YAML, or argv. The
# admin Unix socket is the only path for `workosctl credential put|rotate|
# revoke|list`. Both values are required together; absent keeps the vault
# unavailable while every other Core function starts normally.
WORKOS_CREDENTIAL_MASTER_KEY_FILE=/etc/workos/vault/master.key
WORKOS_CREDENTIAL_ADMIN_SOCKET=/run/workos/credential-admin.sock

# Non-secret Project Harness binding preset. Resource enforcement is not yet
# implemented; this value is currently a versioned policy reference only.
WORKOS_PROJECT_HARNESS_INSTANCE_POLICY=ephemeral
WORKOS_PROJECT_HARNESS_PROFILE_ID=
WORKOS_PROJECT_HARNESS_RESOURCE_POLICY_ID=project-no-tools
